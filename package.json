{
  "name": "traveloop",
  "version": "1.0.0",
  "private": true,
  "description": "Traveloop — Personalized Travel Planning Made Easy",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run start:dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "test": "npm run test --workspace=backend"
  },
  "keywords": [
    "travel",
    "planner",
    "itinerary",
    "budget",
    "trip"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
